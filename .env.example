# AlphaScope Environment Variables
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control

# ============== LLM Provider Keys ==============
# DeepSeek (required, fallback provider)
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Claude (Anthropic)
CLAUDE_API_KEY=sk-ant-xxx
CLAUDE_BASE_URL=https://api.anthropic.com

# GPT (OpenAI)
GPT_API_KEY=sk-xxx
GPT_BASE_URL=https://api.openai.com

# Mimo (Xiaomi)
MIMO_API_KEY=xxx
MIMO_BASE_URL=https://api.mimo.ai

# SenseNova
SENSENOVA_API_KEY=xxx
SENSENOVA_BASE_URL=https://api.sensenova.cn

# Kimi (Moonshot)
KIMI_API_KEY=sk-xxx
KIMI_BASE_URL=https://api.moonshot.cn

# ============== Data Provider Keys ==============
# Finnhub (free tier: 60 req/min)
FINNHUB_API_KEY=xxx

# FRED (Federal Reserve Economic Data, free)
FRED_API_KEY=xxx

# Tushare Pro
TUSHARE_TOKEN=xxx

# ============== Optional Settings ==============
# Allow local/custom LLM base URLs. Desktop build defaults to 1 so the
# "custom API endpoint" feature works out of the box. Set 0 for server deployments.
ALLOW_LOCAL_LLM_BASE_URL=1

# Streamlit server config
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=alphascope

# ============== API Security (auto-managed, usually leave blank) ==============
# ALPHASCOPE_LOCAL_API_TOKEN=  # 本地 API 认证 token; 留空则打包态由 launcher 随机生成
# ALPHASCOPE_ALLOW_ALL_CORS=   # 设 1 全开放 CORS(不推荐); 默认仅放行 localhost 同源
# ALPHASCOPE_CORS_ORIGINS=     # 逗号分隔的允许源(部署场景), 如 https://app.example.com
# ALPHASCOPE_CORS_ORIGIN_REGEX=  # 允许源正则; 默认 ^https?://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$

# ============== Custom Provider Keys ==============
# Add your custom data source API keys here
# See custom_providers/README.md for how to create custom providers
# MY_CUSTOM_API_KEY=xxx
